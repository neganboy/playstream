<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/ConsoleCard"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/artLayout"
            android:layout_width="0dp"
            android:layout_height="@dimen/console_art_height"
            android:background="@drawable/console_art_unknown"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/stateIndicatorImageView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/console_image_height"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/console_image_offset"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_console_ps5_ready" />

            <TextView
                android:id="@+id/statusTextView"
                android:visibility="gone"
                style="@style/StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/status_dot"
                tools:drawableTint="@color/state_ready"
                tools:text="Ready" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:backgroundTint="?attr/colorSurfaceContainerHighest"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="@color/console_card_stroke"
                app:strokeWidth="3dp"
                android:contentDescription="@string/action_more"
                app:icon="@drawable/ic_more_vert" />
        </FrameLayout>

        <TextView
            android:id="@+id/nameTextView"
            android:textAlignment="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/artLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="PS5-493" />

        <TextView
            android:id="@+id/hostTextView"
            android:textAlignment="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/nameTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="PS5 · 192.168.1.20" />

        <TextView
            android:id="@+id/bottomInfoTextView"
            android:textAlignment="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/hostTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Playing Hogwarts Legacy" />

        <!-- Quick quality for this console: sets its own quality, not the global one -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/qualityToggleGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintTop_toBottomOf="@id/bottomInfoTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qualityCompetitiveButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quality_competitive"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qualityBalancedButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quality_balanced"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qualitySharpButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quality_sharp"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qualityUltraButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quality_ultra_short"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Shows what selecting the card does; the card itself handles the click -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryActionButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:clickable="false"
            android:focusable="false"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:textSize="17sp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="28dp"
            app:iconTint="?attr/colorOnPrimary"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintTop_toBottomOf="@id/qualityToggleGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:icon="@drawable/ic_play"
            tools:text="Play" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
